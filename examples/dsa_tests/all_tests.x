import System.utils.Collections

any function main() {
    print("=== Running All DSA Tests ===\n")
    
    // HashMap Tests
    print("--- HashMap ---")
    let map = new Collections.HashMap()
    map.set("key1", "value1")
    map.set("key2", 42)
    print("Created map with 2 entries")
    print("Size:", map.size())
    print("Get key1:", map.get("key1"))
    print("Has key2:", map.has("key2"))
    print("Keys:", map.keys())
    print("Values:", map.values())
    print("Entries:", map.entries())
    map.remove("key1")
    print("Size after remove:", map.size())
    map.clear()
    print("Size after clear:", map.size())
    
    // LinkedList Tests
    print("\n--- LinkedList ---")
    let list = new Collections.LinkedList()
    list.add("first")
    list.add("second")
    list.add("third")
    print("Created list with 3 elements")
    print("Size:", list.size())
    print("Get index 0:", list.get(0))
    print("Get first:", list.getFirst())
    print("Get last:", list.getLast())
    list.addFirst("zero")
    print("After addFirst:", list.getFirst())
    list.remove("second")
    print("Size after remove:", list.size())
    print("To array:", list.toArray())
    
    // Stack Tests
    print("\n--- Stack ---")
    let stack = new Collections.Stack()
    stack.push("a")
    stack.push("b")
    stack.push("c")
    print("Pushed a, b, c")
    print("Size:", stack.size())
    print("Peek:", stack.peek())
    print("Pop:", stack.pop())
    print("Peek after pop:", stack.peek())
    print("To array:", stack.toArray())
    
    // Queue Tests
    print("\n--- Queue ---")
    let queue = new Collections.Queue()
    queue.enqueue("x")
    queue.enqueue("y")
    queue.enqueue("z")
    print("Enqueued x, y, z")
    print("Size:", queue.size())
    print("Peek:", queue.peek())
    print("Dequeue:", queue.dequeue())
    print("Peek after dequeue:", queue.peek())
    print("To array:", queue.toArray())
    
    // PriorityQueue Tests
    print("\n--- PriorityQueue ---")
    let pq = new Collections.PriorityQueue()
    pq.enqueue(5)
    pq.enqueue(2)
    pq.enqueue(8)
    print("Enqueued 5, 2, 8")
    print("Size:", pq.size())
    print("Peek (should be 2):", pq.peek())
    print("Dequeue:", pq.dequeue())
    print("Next peek:", pq.peek())
    
    // Trie Tests
    print("\n--- Trie ---")
    let trie = new Collections.Trie()
    trie.insert("hello")
    trie.insert("world")
    trie.insert("hey")
    print("Inserted: hello, world, hey")
    print("Search 'hello':", trie.search("hello"))
    print("Search 'hey':", trie.search("hey"))
    print("Starts with 'he':", trie.startsWith("he"))
    print("All words:", trie.getAllWords())
    print("Size:", trie.size())
    trie.remove("hey")
    print("Size after remove 'hey':", trie.size())
    
    print("\n=== All DSA tests completed ===")
}
