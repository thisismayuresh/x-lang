import System.io.Console

Console.print("Testing System.io.Console")
Console.print("Hello", "World")

let int age = Console.input("Enter your age: ")
Console.print("Age is:", age)

let string name = Console.input("Enter your name: ")
Console.print("Name is:", name)

let float height = Console.input("Enter your height: ")
Console.print("Height is:", height)

let boolean isStudent = Console.input("Are you a student? (true/false): ")
Console.print("Is student:", isStudent)