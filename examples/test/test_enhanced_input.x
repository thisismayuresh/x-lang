print("Testing enhanced input with type validation:")
let age = input("Enter your age: ", "int")
print("You are " + age + " years old")

let height = input("Enter your height: ", "float")
print("Your height is " + height + " meters")

let isStudent = input("Are you a student? (true/false): ", "bool")
print("Student status: " + isStudent)

let name = input("Enter your name: ", "string")
print("Hello, " + name + "!")