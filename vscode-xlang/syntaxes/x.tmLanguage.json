{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "X",
  "scopeName": "source.x",
  "fileTypes": ["x"],
  "injectionSelector": "L:text.html -source -meta.tag",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#storage" },
    { "include": "#functions" },
    { "include": "#classes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#decorators" },
    { "include": "#interpolation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.x",
          "match": "//.*$"
        },
        {
          "name": "comment.block.x",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [
            { "include": "#comments" }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.x",
          "match": "\\b(if|else|while|for|switch|case|default|return|break|continue|try|catch|finally|throw|match)\\b"
        },
        {
          "name": "keyword.declaration.x",
          "match": "\\b(class|interface|enum|type|function|let|const|var|import|export|package|namespace|extends|implements)\\b"
        },
        {
          "name": "keyword.modifier.x",
          "match": "\\b(public|private|protected|static|final|abstract|async|await|override)\\b"
        },
        {
          "name": "keyword.operator.new.x",
          "match": "\\bnew\\b"
        },
        {
          "name": "keyword.operator.instanceof.x",
          "match": "\\binstanceof\\b"
        },
        {
          "name": "keyword.other.x",
          "match": "\\b(this|super|constructor)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.x",
          "match": "\\b(int|string|float|boolean|void|any|null|undefined)\\b"
        },
        {
          "name": "storage.type.generic.x",
          "match": "\\b(Array|Map|Set|List|Promise|Optional|Result)\\b"
        }
      ]
    },
    "storage": {
      "patterns": [
        {
          "name": "storage.modifier.x",
          "match": "\\b(public|private|protected|static|final|abstract|readonly)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.x",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.x" }
          }
        },
        {
          "name": "support.function.builtin.x",
          "match": "\\b(print|range|typeOf|sleep|input|args|parseInt|parseFloat|toString|length|push|pop|map|filter|reduce|forEach|find|some|every|includes|indexOf|slice|splice|sort|reverse|keys|values|entries|hasOwnProperty|toFixed|toPrecision|charAt|charCodeAt|substring|substr|split|join|trim|toUpperCase|toLowerCase|replace|match|search)\\b"
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.x",
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\b",
          "comment": "Matches PascalCase class/interface names"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.x",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#interpolation" },
            { "include": "#escape-sequences" }
          ]
        },
        {
          "name": "string.quoted.single.x",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "include": "#escape-sequences" }
          ]
        },
        {
          "name": "string.template.x",
          "begin": "`",
          "end": "`",
          "patterns": [
            { "include": "#interpolation" },
            { "include": "#escape-sequences" }
          ]
        }
      ]
    },
    "escape-sequences": {
      "patterns": [
        {
          "name": "constant.character.escape.x",
          "match": "\\\\(?:[\\\\\"'nrtbfav0]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|u\\{[0-9a-fA-F]+\\})"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "template.expression.begin.x",
          "match": "\\$\\{",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#functions" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.x",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.x",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.hex.x",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.x",
          "match": "=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>="
        },
        {
          "name": "keyword.operator.arithmetic.x",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.comparison.x",
          "match": "==|!=|===|!==|<|>|<=|>="
        },
        {
          "name": "keyword.operator.logical.x",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.x",
          "match": "&|\\||\\^|~|<<|>>"
        },
        {
          "name": "keyword.operator.ternary.x",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.accessor.x",
          "match": "\\.|::"
        },
        {
          "name": "punctuation.x",
          "match": "[{}()\\[\\],;:]"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.x",
          "begin": "@",
          "end": "(?=\\s|$)",
          "patterns": [
            {
              "name": "entity.name.function.decorator.x",
              "match": "[a-zA-Z_][a-zA-Z0-9_]*"
            }
          ]
        }
      ]
    }
  }
}